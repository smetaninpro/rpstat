NODE_ENV=development
POSTGRES_DB=rmrp_portal
POSTGRES_USER=rmrp_app
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql://rmrp_app:replace-with-a-random-local-password@postgres:5432/rmrp_portal?schema=public
FRONTEND_ORIGIN=http://127.0.0.1:3000
SESSION_SECRET=replace-with-at-least-32-random-bytes
COLLECTOR_SHARED_SECRET=replace-with-at-least-32-random-bytes
ALLOWED_DISCORD_GUILD_ID=123456789012345678
MAX_SEQUENCE_RANGE=30
COLLECTOR_ENABLED=false
